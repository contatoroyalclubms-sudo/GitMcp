# Railway Environment Variables Template
# Copy these to your Railway project's Variables section

# Basic Configuration
NODE_ENV=production
PORT=3000

# Database URLs (automatically provided by Railway addons)
# DATABASE_URL=postgresql://... (provided by PostgreSQL service)
# REDIS_URL=redis://... (provided by Redis service)

# Application Secrets (replace with your actual values)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
API_KEY=your_api_key_here

# CORS Configuration
FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-admin-domain.com

# Session Configuration
SESSION_SECRET=your_session_secret_here_minimum_32_characters

# Email Configuration (if applicable)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Third-party APIs (adjust as needed)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Logging Configuration
LOG_LEVEL=info