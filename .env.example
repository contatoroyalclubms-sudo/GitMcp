# Environment Configuration
NODE_ENV=development  # Options: development, production

# Database Configuration
# For development: Set DB_TYPE=sqlite (no PostgreSQL needed)
# For production/Docker: Set DB_TYPE=postgres
DB_TYPE=sqlite  # Options: sqlite, postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gitmecp
DB_USER=postgres
DB_PASSWORD=your-secure-password-here  # REQUIRED for PostgreSQL
DB_SSL=false
DB_STORAGE=./database.sqlite  # Only for SQLite

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production  # REQUIRED - Generate a secure key
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3000

# Terminal Configuration
TERMINAL_ID=TERM-001
TERMINAL_NAME=Terminal 1
TERMINAL_LOCATION=Main Floor

# Stripe Payment (Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Anthropic AI (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Logging
LOG_LEVEL=info  # Options: error, warn, info, debug