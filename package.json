{
  "name": "gitmcp-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "deploy": "node railway-quick-deploy.js",
    "deploy:manual": "node deploy-manual.js",
    "deploy:sistema-meep01": "node railway-quick-deploy.js sistema-meep01",
    "deploy:protective-patience": "node railway-quick-deploy.js protective-patience",
    "deploy:sweet-healing": "node railway-quick-deploy.js sweet-healing",
    "deploy:melodious-cooperation": "node railway-quick-deploy.js melodious-cooperation",
    "link": "railway link",
    "status": "railway status",
    "logs": "railway logs",
    "rollback": "railway down",
    "health-check": "curl -f http://localhost:3000/health || node -e \"console.log('Health check failed')\"",
    "test:local": "node server.js & sleep 2 && npm run health-check && pkill -f 'node server.js'"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "readline-sync": "^1.4.10"
  },
  "keywords": [
    "express",
    "railway",
    "deployment",
    "zero-downtime"
  ],
  "description": "GitMcp Server with automated Railway deployment"
}
