# Arquivo de configuração de ambiente para desenvolvimento
# Copie este arquivo para .env e configure as variáveis

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/meep_supremo?schema=public"
DATABASE_URL_TEST="postgresql://postgres:password@localhost:5432/meep_supremo_test?schema=public"

# JWT
JWT_SECRET="meep-supremo-jwt-secret-key-super-secure-2024"
JWT_REFRESH_SECRET="meep-supremo-refresh-secret-key-super-secure-2024"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PORT=8000
API_HOST="localhost"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Frontend
VITE_API_URL="http://localhost:8000"
VITE_APP_NAME="MEEP Supremo"
VITE_APP_VERSION="1.0.0"

# Email (exemplo com Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="MEEP Supremo <noreply@meep-supremo.com>"

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Payment (Stripe)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Analytics
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=10

# Redis (opcional)
REDIS_URL="redis://localhost:6379"

# Logs
LOG_LEVEL="debug"
LOG_FILE="logs/app.log"

# Features
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_DEBUG=true
